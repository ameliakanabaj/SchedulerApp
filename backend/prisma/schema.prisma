generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  organization_id Int     @id @default(autoincrement())
  name            String  @db.VarChar(255)
  shifts          Shift[]
  users           User[]
}

model User {
  user_id         Int        @id @default(autoincrement())
  organization_id Int?
  first_name      String     @db.VarChar(255)
  last_name       String     @db.VarChar(255)
  email           String     @unique @db.VarChar(255)
  password        String     @db.VarChar(255)
  role            UserRole  @default(EMPLOYEE)
  position        String?    @db.VarChar(255)
  assignments     Assignment[]
  availabilities  Availability[]

  organization Organization? @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_user_email")
}

model Shift {
  shift_id        Int          @id @default(autoincrement())
  organization_id Int
  start_time      DateTime
  end_time        DateTime
  required_people Int?
  place           String?      @db.VarChar(255)
  assignments     Assignment[]
  organization    Organization @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade, onUpdate: NoAction)
}

model Availability {
  availability_id Int       @id @default(autoincrement())
  user_id         Int
  start_time      DateTime
  end_time        DateTime
  comments        String?   @db.VarChar(500)
  user            User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_availability_user_id")
}

model Assignment {
  assignment_id Int     @id @default(autoincrement())
  shift_id      Int
  schedule_id   Int
  user_id       Int
  role_on_shift String? @db.VarChar(255)
  shift         Shift   @relation(fields: [shift_id], references: [shift_id], onDelete: Cascade, onUpdate: NoAction)
  user          User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([shift_id, user_id], map: "uq_shift_user")
  @@index([shift_id], map: "idx_assignment_shift_id")
  @@index([user_id], map: "idx_assignment_user_id")
}

model Schedule {
  schedule_id     Int             @id @default(autoincrement())
  organization_id Int
  date_from       DateTime
  date_to         DateTime
  generated_at    DateTime        @default(now())
  status          ScheduleStatus  @default(PENDING)
  deadline_generate_date DateTime

  organization    Organization    @relation(fields: [organization_id], references: [organization_id])
  assignments     Assignment[]    // all assignments created for this schedule

  @@index([organization_id])
}

enum ScheduleStatus {
  PENDING
  GENERATED
  FAILED
  APPROVED
  NOT_APPROVED
}

enum UserRole {
  GLOBAL_ADMIN
  ORG_ADMIN
  EMPLOYEE
}
